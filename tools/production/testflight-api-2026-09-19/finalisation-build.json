    "body": {
      "data": {
        "type": "betaBuildLocalizations",
        "id": "ce24d95d-6b76-4878-84d8-b07a978068fb",
        "attributes": {
          "whatsNew": "Test the full experience with a new account:\n• Sign in with Apple, then choose your language, name and goal.\n• Check that workouts, coins, boosters and your collection start empty.\n• Complete a strength or cardio workout.\n• View the session stories, rewards and completed pebble animation.\n• Open the earned booster and find the card in your collection.\n• Tap a completed day in the Regularity widget to revisit its workout. Choose a session when the day contains several.\n• Sign out and back in: workouts, reward receipts and your collection should return without duplicate rewards.\n• Return on another day to check the daily return.\n\nIf something goes wrong, include the step, iPhone model, iOS version and a screenshot through TestFlight.",
          "locale": "en-GB"
        },
        "relationships": {
          "build": {
            "links": {
              "self": "https://api.appstoreconnect.apple.com/v1/betaBuildLocalizations/ce24d95d-6b76-4878-84d8-b07a978068fb/relationships/build",
