+                        let vu = bits[col] == "1" && seuil <= p
+                        if vu {
+                            ctx.fill(Path(ellipseIn:
+                                r.insetBy(dx: -1.7, dy: -1.7)),
+                                with: .color(bloom.opacity(0.26)))
+                            ctx.fill(Path(ellipseIn: r),
+                                     with: .color(allumee))
+                        } else {
+                            ctx.fill(Path(ellipseIn: r),
+                                     with: .color(.white.opacity(0.04)))
+                        }
+                    }
+                }
+            }
+        }
+        .frame(width: large, height: haute)
+        .background {
