+    /// Un afficheur LED ne connaît pas les accents.
+    private var lettres: [Character] {
+        var brut = texte.uppercased()
+        let paires: [(String, String)] = [
+            ("\u{00C0}", "A"), ("\u{00C2}", "A"), ("\u{00C9}", "E"),
+            ("\u{00C8}", "E"), ("\u{00CA}", "E"), ("\u{00CE}", "I"),
