     /// demandent pas : ils gardent leur cadrage.
     var cadreDecoupe: Bool = false
 
+    final class Vue: SCNView {
+        var danse = false
+        var auRepos = true
+        override func didMoveToWindow() {
+            super.didMoveToWindow()
+            actualiserDanse()
+        }
+        func actualiserDanse() {
+            let cles = ["danse-profil-angle", "danse-profil-echelle"]
+            guard danse, !auRepos, window != nil else {
+                for cle in cles { layer.removeAnimation(forKey: cle) }
+                return
+            }
+            guard layer.animation(forKey: cles[0]) == nil else { return }
+            let instant = Date().timeIntervalSinceReferenceDate
+            for (i, periode) in [7.3, 11.0].enumerated() {
+                let animation = CAKeyframeAnimation(keyPath:
+                    i == 0 ? "transform.rotation.z" : "transform.scale")
+                animation.values = (0...64).map { pas in
+                    let onde = sin(Double(pas) / 64 * 2 * .pi + (i == 0 ? 0 : 1.4))
+                    return i == 0 ? 2.5 * .pi / 180 * onde : 1 + 0.025 * onde
+                }
+                animation.duration = periode
+                animation.repeatCount = .infinity
+                animation.timeOffset = instant.truncatingRemainder(dividingBy: periode)
+                animation.beginTime = layer.convertTime(CACurrentMediaTime(), from: nil)
+                animation.calculationMode = .linear
+                layer.add(animation, forKey: cles[i])
+            }
+        }
+    }
+
