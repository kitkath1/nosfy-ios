+/// Une famille AU HASARD DANS UNE RARETÉ — jamais au hasard dans les 25.
+/// ⚠️ Payé (lu le 17-09) : le chemin « neuve » (35 % des tirages, et tout
+/// tirage dont le pool est vide) prenait `FAMILLES[random]`, donc la rareté
+/// de la carte neuve suivait le NOMBRE DE FAMILLES (4 / 11 / 4 / 6) et non
+/// les POIDS (60 / 27 / 10 / 3) : une légendaire une fois sur dix au lieu
+/// d'une sur trente-trois. Les deux chemins tirent désormais la même rareté.
+function familleTiree(rarete: string): Famille {
+  const du = FAMILLES.filter((f) => f.rarete === rarete);
+  const parmi = du.length > 0 ? du : FAMILLES;
+  return parmi[Math.floor(Math.random() * parmi.length)];
+}
